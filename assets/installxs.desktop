[Desktop Entry]
Name=InstallXS
Comment=Universal Arch Linux App Hub & Drop Installer
Exec=installxs %F
Terminal=false
Type=Application
Icon=system-software-install
Categories=System;PackageManager;Settings;
MimeType=application/vnd.appimage;application/x-tar;application/gzip;application/x-xz;application/zip;application/vnd.debian.binary-package;
Keywords=package;install;appimage;pacman;aur;flatpak;cleaner;uninstall;
StartupNotify=true
